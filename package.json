{
  "private": true,
  "name": "sigil-security",
  "description": "Stateless cryptographic request intent verification primitive",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:bench": "pnpm run test:bench:core",
    "test:bench:core": "pnpm --filter @sigil-security/core run bench",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && pnpm run test:coverage:verify",
    "test:coverage:verify": "node scripts/verify-coverage.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "changeset": "npx @changesets/cli",
    "version-packages": "npx @changesets/cli version",
    "release": "pnpm run build && npx @changesets/cli publish"
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.9",
      "rollup@4.57.1": "4.60.1",
      "flatted@3.3.3": "3.4.2",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "ajv@6.12.6": "6.14.0",
      "brace-expansion@1.1.12": "1.1.13",
      "brace-expansion@2.0.2": "2.0.3",
      "path-to-regexp@8.3.0": "8.4.0",
      "elysia@1.4.25": "1.4.28",
      "fastify@5.7.4": "5.8.3"
    }
  },
  "type": "module"
}
