{
  "name": "@sigil-security/ops",
  "version": "2.0.0",
  "description": "Experimental telemetry, monitoring, and anomaly detection — optional observability layer",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "pnpm run typecheck:src && pnpm run typecheck:tests",
    "typecheck:src": "tsc --noEmit --project tsconfig.typecheck.json",
    "typecheck:tests": "tsc --noEmit --project tsconfig.json"
  },
  "keywords": [
    "csrf",
    "security",
    "telemetry",
    "monitoring",
    "observability"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/laphilosophia/sigil-security/tree/main/packages/ops#readme",
  "bugs": {
    "url": "https://github.com/laphilosophia/sigil-security/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/laphilosophia/sigil-security.git",
    "directory": "packages/ops"
  },
  "dependencies": {
    "@sigil-security/runtime": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "experimental"
  }
}

